# Zoho SMTP (contact form delivery via the hello@quantumshamanicreiki.com mailbox).
# Without these vars, /api/contact logs to console and returns ok.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hello@quantumshamanicreiki.com
SMTP_PASS=
INQUIRY_EMAIL_TO=hello@quantumshamanicreiki.com
INQUIRY_EMAIL_FROM=QSR <hello@quantumshamanicreiki.com>
